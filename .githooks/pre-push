#!/usr/bin/env bash
#
# Pre-push gate. Runs the local quality gate before any push is allowed.
# Constitution (Local-only quality gates): checks run locally and MUST pass
# before code reaches the repository.
#
# Bypass (discouraged; only with explicit human authorization):
#   SKIP_GATE=1 git push      # or:  git push --no-verify
set -uo pipefail

if [ "${SKIP_GATE:-0}" = "1" ]; then
  echo "pre-push: SKIP_GATE=1 set — gate bypassed (not recommended)." >&2
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
echo "pre-push: running local quality gate (set SKIP_GATE=1 to bypass)…" >&2
exec "$ROOT/scripts/ci/gate.sh"
